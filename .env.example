# Avisos por email (opcional): para recibir la notificación de salidas de stock
# en el email del área destino. Si MAIL_ENABLED no es "true" o falta SMTP_HOST,
# el envío se omite (solo se registra en el log).
MAIL_ENABLED=false
SMTP_HOST=smtp.tudominio.com
SMTP_PORT=587
SMTP_USER=no-reply@tudominio.com
SMTP_PASS=TU_PASSWORD_SMTP
SMTP_FROM=Stock <no-reply@tudominio.com>

# Ejemplo con Gmail:
#   1) Activar verificación en 2 pasos en la cuenta de Google
#      (https://myaccount.google.com/security)
#   2) Crear una "Contraseña de aplicación" en
#      https://myaccount.google.com/apppasswords (16 caracteres, sin espacios)
#   3) Configurar:
# MAIL_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tucuenta@gmail.com
# SMTP_PASS=abcdabcdabcdabcd   <- la contraseña de aplicación, NO la normal
# SMTP_FROM=Stock <tucuenta@gmail.com>

